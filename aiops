    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // --- Page/View Switching Logic ---
            const navItems = document.querySelectorAll('.nav-item');
            const pageContents = document.querySelectorAll('.page-content');
            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    const targetId = item.getAttribute('data-target');
                    if (!targetId) return;
                    navItems.forEach(nav => nav.classList.remove('active'));
                    item.classList.add('active');
                    pageContents.forEach(content => content.classList.toggle('active', content.id === targetId));
                });
            });

             // --- Chart Generation ---
            const chartArea = document.getElementById('chartArea');
            if (chartArea) {
                chartArea.innerHTML = '';
                for (let i = 0; i < 24; i++) {
                    const bar = document.createElement('div');
                    bar.classList.add('chart-bar');
                    bar.style.height = `${Math.random() * (98 - 70) + 70}%`;
                    chartArea.appendChild(bar);
                }
            }

            // --- AI Agent Chat Logic ---
            const chatMessages = document.getElementById('chatMessages');
            const chatInput = document.getElementById('chatInput');
            const chatSendBtn = document.getElementById('chatSendBtn');
            if (chatSendBtn) {
                const agentResponses = {"status": "All systems are currently reporting 100% uptime. However, I'm tracking a performance degradation warning on AppSvc-Gateway.", "sql": "SQL-DB-PROD-01 is under high load and is at critical risk of failure within 12 hours. I recommend allocating more resources or investigating the running queries.", "risk": "The highest risk component is SQL-DB-PROD-01 due to sustained high CPU. I've also flagged 12 VMs that are missing a critical security patch.", "default": "I can help with system status, risk analysis, and performance metrics. Please ask me about a specific service like 'SQL status' or 'high risk components'."};
                const addMessage = (text, sender) => {
                    const messageDiv = document.createElement('div');
                    messageDiv.classList.add('message', sender);
                    messageDiv.textContent = text;
                    chatMessages.appendChild(messageDiv);
                    chatMessages.scrollTop = chatMessages.scrollHeight;
                };
                const handleChatSubmit = () => {
                    const userInput = chatInput.value.trim();
                    if (userInput) {
                        addMessage(userInput, 'user');
                        chatInput.value = '';
                        setTimeout(() => {
                            let response = agentResponses.default;
                            if (userInput.toLowerCase().includes('status')) response = agentResponses.status;
                            else if (userInput.toLowerCase().includes('sql')) response = agentResponses.sql;
                            else if (userInput.toLowerCase().includes('risk')) response = agentResponses.risk;
                            addMessage(response, 'agent');
                        }, 1000 + Math.random() * 500);
                    }
                };
                chatSendBtn.addEventListener('click', handleChatSubmit);
                chatInput.addEventListener('keypress', (e) => e.key === 'Enter' && handleChatSubmit());
            }
            
            // --- Recommended Actions Logic ---
            const actionsList = document.querySelector('.actions-list');
            if(actionsList) {
                actionsList.addEventListener('click', (e) => {
                    if(e.target.classList.contains('accept-btn') || e.target.classList.contains('dismiss-btn')) {
                        const actionItem = e.target.closest('.summary-item');
                        actionItem.style.transition = 'opacity 0.5s ease';
                        actionItem.style.opacity = '0';
                        setTimeout(() => actionItem.remove(), 500);
                    }
                });
            }

            // --- Alerts Center Logic ---
            const alertsTableBody = document.getElementById('alertsTableBody');
            if (alertsTableBody) {
                let alertsData = [
                    { id: 1, severity: 'high', status: 'new', service: 'SQL-DB-PROD-01', description: 'CPU utilization has exceeded 95% for 15 minutes.', timestamp: new Date(Date.now() - 5 * 60000) },
                    { id: 2, severity: 'medium', status: 'new', service: 'AppSvc-Gateway', description: 'Response latency is above 2000ms.', timestamp: new Date(Date.now() - 25 * 60000) },
                    { id: 3, severity: 'low', status: 'acknowledged', service: 'Storage-Prod', description: 'Storage account capacity is at 85%.', timestamp: new Date(Date.now() - 65 * 60000) },
                    { id: 4, severity: 'medium', status: 'new', service: 'AKS-Cluster-Prod', description: 'Node is unresponsive and needs reboot.', timestamp: new Date(Date.now() - 120 * 60000) },
                    { id: 5, severity: 'high', status: 'resolved', service: 'VM-Auth-Service', description: 'Critical security vulnerability CVE-2024-12345 detected.', timestamp: new Date(Date.now() - 240 * 60000) },
                    { id: 6, severity: 'low', status: 'resolved', service: 'CosmosDB-WestUS', description: 'Request units are nearing provisioned limit.', timestamp: new Date(Date.now() - 500 * 60000) }
                ];

                const severityColors = { high: 'var(--danger-red)', medium: 'var(--warning-yellow)', low: 'var(--success-green)' };
                const searchInput = document.getElementById('alertSearchInput');
                const severityFilter = document.getElementById('severityFilter');
                const statusFilter = document.getElementById('statusFilter');
                const timeSince = (date) => { const seconds = Math.floor((new Date() - date) / 1000); let interval = seconds / 31536000; if (interval > 1) return Math.floor(interval) + " years ago"; interval = seconds / 2592000; if (interval > 1) return Math.floor(interval) + " months ago"; interval = seconds / 86400; if (interval > 1) return Math.floor(interval) + " days ago"; interval = seconds / 3600; if (interval > 1) return Math.floor(interval) + " hours ago"; interval = seconds / 60; if (interval > 1) return Math.floor(interval) + " minutes ago"; return Math.floor(seconds) + " seconds ago"; };
                const renderAlerts = () => {
                    const filters = { search: searchInput.value.toLowerCase(), severity: severityFilter.value, status: statusFilter.value };
                    const filteredAlerts = alertsData.filter(a => (a.service.toLowerCase().includes(filters.search) || a.description.toLowerCase().includes(filters.search)) && (filters.severity === 'all' || a.severity === filters.severity) && (filters.status === 'all' || a.status === filters.status));
                    alertsTableBody.innerHTML = filteredAlerts.map(alert => `<tr data-id="${alert.id}"><td><span class="severity-indicator" style="color: ${severityColors[alert.severity]}">${alert.severity}</span></td><td><span class="status-tag ${alert.status}">${alert.status}</span></td><td>${alert.service}</td><td style="white-space: normal;">${alert.description}</td><td>${timeSince(alert.timestamp)}</td><td class="table-actions">${alert.status === 'new' ? '<button class="acknowledge">Acknowledge</button>' : ''}${alert.status !== 'resolved' ? '<button class="resolve">Resolve</button>' : ''}</td></tr>`).join('');
                    updateSummary();
                };
                const updateSummary = () => { document.getElementById('total-alerts-summary').textContent = alertsData.length; document.getElementById('unresolved-alerts-summary').textContent = alertsData.filter(a => a.status !== 'resolved').length; document.getElementById('high-priority-summary').textContent = alertsData.filter(a => a.severity === 'high' && a.status !== 'resolved').length; };
                alertsTableBody.addEventListener('click', e => { const row = e.target.closest('tr'); if (!row) return; const alertId = parseInt(row.dataset.id), alert = alertsData.find(a => a.id === alertId); if (e.target.classList.contains('acknowledge')) { alert.status = 'acknowledged'; } else if (e.target.classList.contains('resolve')) { alert.status = 'resolved'; } renderAlerts(); });
                searchInput.addEventListener('input', renderAlerts);
                severityFilter.addEventListener('change', renderAlerts);
                statusFilter.addEventListener('change', renderAlerts);
                renderAlerts();
            }

            // --- Simulations Tool Logic ---
            const simViz = document.getElementById('simulationViz');
            if (simViz) {
                const targetServiceSelect = document.getElementById('targetService');
                const runBtn = document.getElementById('runSimulationBtn');
                const resetBtn = document.getElementById('resetSimulationBtn');
                const simLog = document.getElementById('simulationLog');

                let services = [
                    { id: 'AppSvc-Gateway', dependencies: ['SQL-DB-PROD-01', 'VM-Auth-Service'], status: 'healthy', pos: { x: '50%', y: '10%' } },
                    { id: 'SQL-DB-PROD-01', dependencies: ['Storage-Prod'], status: 'healthy', pos: { x: '30%', y: '40%' } },
                    { id: 'VM-Auth-Service', dependencies: [], status: 'healthy', pos: { x: '70%', y: '40%' } },
                    { id: 'AKS-Cluster-Prod', dependencies: ['SQL-DB-PROD-01', 'Storage-Prod'], status: 'healthy', pos: { x: '50%', y: '70%' } },
                    { id: 'Storage-Prod', dependencies: [], status: 'healthy', pos: { x: '30%', y: '90%' } }
                ];

                const initSim = () => {
                    simViz.innerHTML = '';
                    targetServiceSelect.innerHTML = '';
                    services.forEach(s => {
                        const node = document.createElement('div');
                        node.className = `sim-node ${s.status}`;
                        node.id = `node-${s.id}`;
                        node.style.left = s.pos.x;
                        node.style.top = s.pos.y;
                        node.style.transform = 'translate(-50%, -50%)';
                        node.textContent = s.id;
                        simViz.appendChild(node);
                        const option = document.createElement('option');
                        option.value = s.id;
                        option.textContent = s.id;
                        targetServiceSelect.appendChild(option);
                    });
                };
                const log = (message, type = 'info') => { simLog.innerHTML += `<p class="log-${type}">[${new Date().toLocaleTimeString()}] ${message}</p>`; simLog.scrollTop = simLog.scrollHeight; };
                const resetSim = () => { services.forEach(s => s.status = 'healthy'); initSim(); log('Simulation environment has been reset.', 'success'); runBtn.disabled = false; resetBtn.disabled = true; };
                const runFailureSim = (targetId) => {
                    log(`Starting failure injection on ${targetId}...`, 'warn'); let queue = [targetId]; let processed = new Set();
                    const processQueue = () => {
                        if (queue.length === 0) { log('Cascading effects simulation complete.', 'success'); resetBtn.disabled = false; return; }
                        const currentId = queue.shift(); processed.add(currentId);
                        const service = services.find(s => s.id === currentId);
                        service.status = service.id === targetId ? 'failed' : 'degraded';
                        document.getElementById(`node-${service.id}`).className = `sim-node ${service.status}`;
                        log(`${service.id} has become ${service.status}.`, service.status === 'failed' ? 'fail' : 'warn');
                        services.forEach(s => { if (s.dependencies.includes(currentId) && !processed.has(s.id)) { queue.push(s.id); } });
                        setTimeout(processQueue, 1500);
                    };
                    processQueue();
                };
                runBtn.addEventListener('click', () => { runBtn.disabled = true; simLog.innerHTML = ''; log('Initializing simulation...'); const target = targetServiceSelect.value; runFailureSim(target); });
                resetBtn.addEventListener('click', resetSim);
                initSim();
            }

            // --- Recommendations Tool Logic ---
            const recommendationsGrid = document.getElementById('recommendationsGrid');
            if (recommendationsGrid) {
                let recommendationsData = [
                    { id: 1, category: 'cost', priority: 'high', status: 'new', title: 'Right-size Underutilized VMs', description: 'Our analysis shows 5 VMs in the "Production" subscription are consistently operating at less than 15% CPU. Downsizing them from D4s_v3 to D2s_v3 could significantly reduce costs without impacting performance.', impact: { value: 450, unit: '$/mo savings' } },
                    { id: 2, category: 'security', priority: 'high', status: 'new', title: 'Enable MFA for Admin Accounts', description: 'Multi-Factor Authentication is not enabled for 3 administrator accounts, posing a significant security risk. Enforce MFA to protect against unauthorized access.', impact: { value: 'Critical', unit: 'Risk Reduction' } },
                    { id: 3, category: 'performance', priority: 'medium', status: 'new', title: 'Upgrade SQL-DB to a Higher Tier', description: 'The primary SQL database is experiencing high DTU saturation during peak hours, leading to query throttling. Upgrading from S2 to S3 tier will improve response times.', impact: { value: '+35%', unit: 'Performance' } },
                    { id: 4, category: 'cost', priority: 'low', status: 'applied', title: 'Delete Unassociated Public IPs', description: 'Found 12 public IP addresses that are no longer associated with any running service. Deleting them will remove unnecessary costs.', impact: { value: 85, unit: '$/mo savings' } },
                    { id: 5, category: 'security', priority: 'medium', status: 'dismissed', title: 'Restrict Network Access to Storage', description: 'The "Storage-Prod" account allows public access. Restrict access to specific virtual networks to enhance data security.', impact: { value: 'High', unit: 'Risk Reduction' } }
                ];

                const categoryFilter = document.getElementById('recCategoryFilter');
                const statusFilter = document.getElementById('recStatusFilter');
                const renderRecommendations = () => {
                    const filters = { category: categoryFilter.value, status: statusFilter.value };
                    const filteredData = recommendationsData.filter(rec => (filters.category === 'all' || rec.category === filters.category) && (filters.status === 'all' || rec.status === filters.status));
                    recommendationsGrid.innerHTML = filteredData.map(rec => `<div class="recommendation-card" data-id="${rec.id}"><div class="rec-header"><span class="rec-category ${rec.category}">${rec.category}</span><span class="severity-badge ${rec.priority}">${rec.priority}</span></div><div class="rec-content"><h3 class="rec-title">${rec.title}</h3><p class="rec-description">${rec.description}</p><div class="rec-impact"><span class="rec-impact-label">Potential Impact:</span><span class="rec-impact-value" style="color:${rec.category === 'cost' ? 'var(--success-green)' : 'var(--dark-blue)'}">${rec.impact.value} ${rec.impact.unit}</span></div></div><div class="rec-footer"><span class="rec-status-tag ${rec.status}">Status: ${rec.status}</span><div class="action-buttons">${rec.status === 'new' ? '<button class="accept-btn">Apply</button><button class="dismiss-btn">Dismiss</button>' : ''}</div></div></div>`).join('');
                    updateRecSummary();
                };
                const updateRecSummary = () => {
                    const activeRecs = recommendationsData.filter(r => r.status === 'new');
                    document.getElementById('rec-active-summary').textContent = activeRecs.length;
                    document.getElementById('rec-high-priority-summary').textContent = activeRecs.filter(r => r.priority === 'high').length;
                    const totalSavings = recommendationsData.filter(r => r.category === 'cost' && r.status !== 'dismissed').reduce((sum, r) => sum + r.impact.value, 0);
                    document.getElementById('rec-savings-summary').textContent = `$${totalSavings}`;
                };
                recommendationsGrid.addEventListener('click', e => {
                    if (e.target.tagName !== 'BUTTON') return;
                    const card = e.target.closest('.recommendation-card');
                    const recId = parseInt(card.dataset.id);
                    const rec = recommendationsData.find(r => r.id === recId);
                    if (e.target.classList.contains('accept-btn')) { rec.status = 'applied'; } else if (e.target.classList.contains('dismiss-btn')) { rec.status = 'dismissed'; }
                    renderRecommendations();
                });
                categoryFilter.addEventListener('change', renderRecommendations);
                statusFilter.addEventListener('change', renderRecommendations);
                renderRecommendations();
            }

            // --- Cloud Migration Tool Logic ---
            const migrationWizard = document.querySelector('.migration-wizard');
            if (migrationWizard) {
                const scanBtn = document.getElementById('scanAzureBtn');
                const scanResults = document.getElementById('scanResults');
                const resourcesTableBody = document.querySelector('#resourcesTable tbody');
                
                const analyzeCostBtn = document.getElementById('analyzeCostBtn');
                const analysisResult = document.getElementById('analysisResult');

                const validatePlanBtn = document.getElementById('validatePlanBtn');
                const migrationPlanTableBody = document.querySelector('#migrationPlanTable tbody');
                
                const startMigrationBtn = document.getElementById('startMigrationBtn');
                const migrationProgress = document.getElementById('migrationProgress');
                const overallProgressBar = document.getElementById('overallProgressBar');
                const migrationStatusTableBody = document.querySelector('#migrationStatusTable tbody');

                const dummyResources = [
                    { name: 'VM-PROD-WEB-01', type: 'Virtual Machine', loc: 'East US', sku: 'Standard_D4s_v3', cost: 800 },
                    { name: 'SQL-DB-PROD-01', type: 'SQL Database', loc: 'East US', sku: 'S3', cost: 1200 },
                    { name: 'storage-prod-logs', type: 'Storage Account', loc: 'East US', sku: 'Standard_LRS', cost: 250 },
                    { name: 'VM-DEV-TEST-01', type: 'Virtual Machine', loc: 'West US', sku: 'Standard_B2s', cost: 150 },
                ];

                const setActiveStep = (stepNumber) => {
                    document.querySelectorAll('.wizard-step').forEach(step => step.classList.remove('active'));
                    document.getElementById(`migration-step-${stepNumber}`).classList.add('active');
                };

                scanBtn.addEventListener('click', () => {
                    scanBtn.textContent = 'Scanning...';
                    scanBtn.disabled = true;
                    resourcesTableBody.innerHTML = `<tr><td colspan="6" style="text-align:center;">Scanning Azure subscriptions...</td></tr>`;
                    scanResults.style.display = 'block';

                    setTimeout(() => {
                        resourcesTableBody.innerHTML = dummyResources.map(r => 
                            `<tr><td>${r.name}</td><td>${r.type}</td><td>${r.loc}</td><td>${r.sku}</td><td>$${r.cost}/mo</td><td id="comp-${r.name}">Pending...</td></tr>`
                        ).join('');
                        scanBtn.textContent = 'Scan Complete';
                    }, 2000);
                });

                analyzeCostBtn.addEventListener('click', () => {
                    analyzeCostBtn.textContent = 'Analyzing...';
                    analyzeCostBtn.disabled = true;
                    
                    setTimeout(() => {
                        document.getElementById('comp-VM-PROD-WEB-01').innerHTML = `<span class="status-tag compatible">Compatible</span>`;
                        document.getElementById('comp-SQL-DB-PROD-01').innerHTML = `<span class="status-tag incompatible">Incompatible</span>`;
                        document.getElementById('comp-storage-prod-logs').innerHTML = `<span class="status-tag compatible">Compatible</span>`;
                        document.getElementById('comp-VM-DEV-TEST-01').innerHTML = `<span class="status-tag compatible">Compatible</span>`;
                        
                        analysisResult.style.display = 'block';
                        analyzeCostBtn.textContent = 'Analysis Complete';
                        
                        setTimeout(() => setActiveStep(2), 1000);

                        migrationPlanTableBody.innerHTML = `
                            <tr><td>VM-PROD-WEB-01</td><td>Large Instance (4vCPU, 16GB RAM)</td><td>Lift & Shift (V2V)</td></tr>
                            <tr><td>SQL-DB-PROD-01</td><td>Self-Hosted PostgreSQL on VM</td><td>Re-platform</td></tr>
                            <tr><td>storage-prod-logs</td><td>NFS Share</td><td>Data Transfer</td></tr>
                            <tr><td>VM-DEV-TEST-01</td><td>Small Instance (2vCPU, 4GB RAM)</td><td>Lift & Shift (V2V)</td></tr>
                        `;
                    }, 2500);
                });

                validatePlanBtn.addEventListener('click', () => {
                    validatePlanBtn.textContent = 'Validated';
                    validatePlanBtn.disabled = true;
                    setActiveStep(3);
                });

                startMigrationBtn.addEventListener('click', () => {
                    startMigrationBtn.disabled = true;
                    migrationProgress.style.display = 'block';
                    const compatibleResources = dummyResources.filter(r => r.name !== 'SQL-DB-PROD-01');
                    migrationStatusTableBody.innerHTML = compatibleResources.map(r => `<tr id="status-row-${r.name}"><td>${r.name}</td><td><span class="status-tag pending">Pending</span></td></tr>`).join('');
                    
                    let completed = 0;
                    const total = compatibleResources.length;

                    compatibleResources.forEach((resource, index) => {
                        setTimeout(() => {
                            const row = document.getElementById(`status-row-${resource.name}`);
                            row.cells[1].innerHTML = `<span class="status-tag in-progress">In Progress...</span>`;

                            setTimeout(() => {
                                const success = Math.random() > 0.1; // 90% success rate
                                row.cells[1].innerHTML = `<span class="status-tag ${success ? 'completed' : 'failed'}">${success ? 'Completed' : 'Failed'}</span>`;
                                completed++;
                                overallProgressBar.style.width = `${(completed / total) * 100}%`;
                                if (completed === total) {
                                    startMigrationBtn.textContent = "Simulation Finished";
                                }
                            }, 3000 + (Math.random() * 2000));
                        }, index * 4000);
                    });
                });
            }
        });
    </script>
</body>
</html>

